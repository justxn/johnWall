{
  "name": "intramural-hoops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode emulator",
    "emulators": "npx -y firebase-tools@15 emulators:start --only auth,firestore --project demo-hoops",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore --project demo-hoops \"vitest run --config vitest.rules.config.js\""
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "lit-html": "^3.3.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
