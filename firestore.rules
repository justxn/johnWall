rules_version = '2';

// Anyone with the link can read team data. Writing needs membership:
//   - 'team' members (joined with the team code) can change anything.
//   - 'fan' members (joined with the fan code) can vote for awards.
// Joining is anonymous sign-in plus a code. The client writes the code to
// joins/{uid} in the same batch as members/{uid}, and these rules compare it to
// config/group, which no client can read unless already on the team.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function memberPath(uid) { return /databases/$(database)/documents/members/$(uid); }
    function isMember() { return signedIn() && exists(memberPath(request.auth.uid)); }
    function me() { return get(memberPath(request.auth.uid)).data; }
    function isTeam() { return isMember() && me().role == 'team'; }
    // Only team members act as a player (votes, no voting for yourself).
    function myPlayerId() { return me().role == 'team' ? me().get('playerId', null) : null; }

    function scheduled(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data.get('status', 'final') == 'scheduled';
    }
    // A bet has to use the line as posted, on a prop that hasn't been pulled.
    function atPostedLine(gameId, bet) {
      let posted = get(/databases/$(database)/documents/games/$(gameId)/lines/$(bet.playerId + '_' + bet.stat)).data;
      return bet.line == posted.line && !posted.get('pulled', false);
    }

    function validJoin(uid, role) {
      let code = getAfter(/databases/$(database)/documents/joins/$(uid)).data.code;
      let group = getAfter(/databases/$(database)/documents/config/group).data;
      return (role == 'team' && code == group.code)
        || (role == 'fan' && group.get('viewerCode', '') != '' && code == group.viewerCode);
    }

    // The secret join codes.
    match /config/group {
      allow read, update: if isTeam();
      // First-time setup: whoever creates the team picks the codes.
      allow create: if signedIn()
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 4;
    }

    // Team name and one-time setup markers.
    match /config/public {
      allow read: if true;
      allow write: if isTeam();
    }

    // Write-only: holds the code someone typed, for validJoin() to check.
    match /joins/{uid} {
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string;
    }

    match /members/{uid} {
      allow read: if isSelf(uid) || isTeam();
      // Join (or switch roles) by proving a code. Only team members get linked
      // to a player.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['role', 'joinedAt', 'name'])
        && request.resource.data.role in ['team', 'fan']
        && validJoin(uid, request.resource.data.role);
      allow update: if isTeam()
        || (isSelf(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
        || (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'joinedAt'])
          && request.resource.data.role in ['team', 'fan']
          && validJoin(uid, request.resource.data.role));
      allow delete: if isSelf(uid) || isTeam();
    }

    match /players/{id} {
      allow read: if true;
      allow write: if isTeam();
    }

    match /awardCategories/{id} {
      allow read: if true;
      allow write: if isTeam();
    }

    match /injuries/{id} {
      allow read: if true;
      allow write: if isTeam();
    }

    // News tab comments. Anyone signed in (even without joining) can post as
    // themselves; only the author or the team can remove one. No edits.
    match /comments/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['itemId', 'text', 'author', 'uid', 'isPlayer', 'createdAt'])
        && request.resource.data.itemId is string && request.resource.data.itemId.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 140
        && request.resource.data.author is string && request.resource.data.author.size() <= 60
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isPlayer is bool
        && (request.resource.data.isPlayer == false || myPlayerId() != null)
        && request.resource.data.createdAt == request.time;
      allow delete: if isTeam() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if isTeam();

      match /stats/{playerId} {
        allow read: if true;
        allow write: if isTeam();
      }

      // One vote per voter per award: the doc id is {voterId}_{categoryId}.
      // Players vote as their player id, everyone else as their sign-in.
      match /votes/{voteId} {
        allow read: if true;
        allow create, update: if isMember()
          && request.resource.data.keys().hasOnly(['gameId', 'categoryId', 'voterId', 'nomineeId'])
          && request.resource.data.gameId == gameId
          && request.resource.data.voterId in [request.auth.uid, myPlayerId()]
          && voteId == request.resource.data.voterId + '_' + request.resource.data.categoryId
          && request.resource.data.nomineeId is string
          && request.resource.data.nomineeId != myPlayerId()
          && (resource == null || resource.data.voterId == request.resource.data.voterId);
        allow delete: if isTeam() || (isMember() && resource.data.voterId in [request.auth.uid, myPlayerId()]);
      }

      // Sportsbook prop lines, id {playerId}_{stat}. Team members post and move
      // them before tip-off, and can always remove them (deleting a game).
      match /lines/{lineId} {
        allow read: if true;
        allow create, update: if isTeam() && scheduled(gameId)
          && request.resource.data.keys().hasOnly(['gameId', 'playerId', 'stat', 'line', 'auto', 'pulled', 'updatedAt'])
          && request.resource.data.gameId == gameId
          && lineId == request.resource.data.playerId + '_' + request.resource.data.stat
          && request.resource.data.line is number;
        allow delete: if isTeam();
      }

      // Bets in in-app coins. Members bet as themselves (like votes), before
      // tip-off, at the posted line, up to 250 coins, never the under on their
      // own props. Bets can't be edited, only cancelled before tip-off.
      match /bets/{betId} {
        allow read: if true;
        allow create: if isMember() && scheduled(gameId)
          && request.resource.data.keys().hasOnly(['gameId', 'bettorId', 'bettorName', 'playerId', 'stat', 'side', 'line', 'stake', 'placedAt'])
          && request.resource.data.gameId == gameId
          && request.resource.data.bettorId in [request.auth.uid, myPlayerId()]
          && request.resource.data.bettorName is string && request.resource.data.bettorName.size() <= 60
          && request.resource.data.side in ['over', 'under']
          && request.resource.data.stake is int && request.resource.data.stake >= 1 && request.resource.data.stake <= 250
          && request.resource.data.placedAt == request.time
          && atPostedLine(gameId, request.resource.data)
          && !(request.resource.data.side == 'under' && request.resource.data.playerId == myPlayerId());
        allow delete: if isTeam() || (isMember() && resource.data.bettorId in [request.auth.uid, myPlayerId()] && scheduled(gameId));
      }
    }

    // Collection-group queries (all stats/votes/bets/lines at once) need their own read rules.
    match /{path=**}/stats/{playerId} { allow read: if true; }
    match /{path=**}/votes/{voteId} { allow read: if true; }
    match /{path=**}/bets/{betId} { allow read: if true; }
    match /{path=**}/lines/{lineId} { allow read: if true; }
  }
}
